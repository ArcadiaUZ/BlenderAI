# ==============================================================
#  FORGE sozlamalari.  Bu faylni `forge\.env` sifatida nusxalang
#  va kalitni to'ldiring:   copy .env.example .env
#  `.env` hech qachon git'ga tushmaydi (.gitignore da).
# ==============================================================

# --- Google AI Studio (FAQAT matn: 3D sxema, qismlar, prompt'lar) ---
# AI Studio -> Get API key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

FORGE_TEXT_MODEL=gemini-2.5-flash

# --- Image-To-3D serveri (rasm -> 3D) ---
FORGE_I2I3D_URL=http://127.0.0.1:8742

# --- Blender (headless render + yig'ish) ---
# `forge\forge.bat doctor` avtomatik topadi, lekin aniq yo'l kirsa bo'ladi.
FORGE_BLENDER=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe

# EEVEE headless'da bo'sh rasm qaytaradi -> faqat CYCLES ishlaydi
FORGE_RENDER_ENGINE=CYCLES
FORGE_CYCLES_DEVICE=GPU
FORGE_CYCLES_BACKEND=OPTIX

# ==============================================================
#  Rasm backendi: local (ComfyUI + Qwen-Image-2.1) | gemini
# ==============================================================
FORGE_IMAGE_BACKEND=local

COMFY_URL=http://127.0.0.1:8188

# ComfyUI papkasi. Nisbatiy yo'l eng yaxshi (repo yonida).
FORGE_COMFY_PATH=ComfyUI
COMFYUI_PATH=ComfyUI

# --- 12 GB VRAM byudjeti -------------------------------------------
# unet 3.995 + text encoder 6.020 + VAE 0.644 = 10.66 GB
# Q6_K unet (5.6 GB) 12 GB GPU'ga SIG'MAYDI -> faqat Q4_K_M ishlatiladi.
# community "heretic" GGUF text encoder kalit nomlari mos kelmaydi ->
# rasmiy qwen3vl_8b_w4a8.safetensors ishlatiladi.
# ---------------------------------------------------------------
FORGE_GGUF=qwen_image_2.1_Q4_K_M.gguf
FORGE_COMFY_CLIP=qwen3vl_8b_w4a8.safetensors
FORGE_COMFY_VAE=qwen_image_2.1_vae_bf16.safetensors
FORGE_COMFY_STEPS=30
FORGE_COMFY_RES=1024
FORGE_COMFY_RESERVE_VRAM=0.5

# ==============================================================
#  PORTABLE: barcha kesh va yuklamalar shu papkada.
#  Bo'sh qoldirilsa, Windows'ning standart kesh papkalari
#  (C:\Users\<user>\.cache) ishlatiladi.
#  Portable uchun shu satrlarni o'chiring va o'z papkangizni yozing.
# ==============================================================
# FORGE_CACHE_ROOT=D:\AI\BlenderAI\cache
# HF_HOME=D:\AI\BlenderAI\cache\hf
# HF_HUB_CACHE=D:\AI\BlenderAI\cache\hf\hub
# TORCH_HOME=D:\AI\BlenderAI\cache\torch